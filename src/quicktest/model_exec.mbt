// ========================================
// Model Exec - 纯模型执行器 — Generated by QuickMachine Code Generator
// FSM: moonxml_doc_ledger | Config: moonxml_conservation_machine
// Generated at: 1794000000000
// 默认实现"可运行但保守"；人工补充点以 TODO(P0)-TODO(P5) 标记
// 手维护实例（.hand-maintained 在案）:P0 接台账镜像——Seed 置基线空序列,
// AppendNode 函数式追加（序列语义含重; assign 表达力不建模集合运算,
// 生成器缺口同 mooncmd 余额算术账）, 守恒判定不住模型（模型是规格,
// 系统侧 conserve_verify 是律）。
// ========================================
// model_execute 是规格（specification），不是被测实现：
// 臂结构与 [[transitions]] 一一对应；纯模型与真实执行器语义漂移由属性测试双执行比较兜底

///|
/// 纯模型执行: (Model, Command) -> (Model, Response)
/// 兜底 (_, _) => Error(0) 为非法转移
fn model_execute(model : Model, cmd : Command) -> (Model, Response) {
  match (model.state, cmd) {
    // --- Fresh ---
    // @arm Fresh+Seed
    (Fresh, Seed) => ({ state: Ledgered, nodes: [], }, Continue)
    // --- Ledgered ---
    // @arm Ledgered+AppendNode（序列语义: 追加恒 Continue, 序列含重）
    (Ledgered, AppendNode(reference)) =>
      match node_index(reference) {
        Some(index) => {
          let next = model.nodes.copy()
          next.push(index)
          ({ state: Ledgered, nodes: next, }, Continue)
        }
        None => (model, Error(3))
      }
    // @arm Ledgered+Roundtrip
    (Ledgered, Roundtrip) => (model, Continue)
    // 兜底: 非法转移（valid 已过滤, 防御性保留）
    (_, _) => (model, Error(0))
  }
}

///|
/// 模型推进（quickcheck_statemachine transition_symbolic/concrete 接口形态）
/// 非法/错误响应不推进模型
fn transition(model : Model, command : Command, response : Response) -> Model {
  match response {
    Error(_) => model
    _ => model_execute(model, command).0
  }
}

///|
test "moonxml_conservation_machine model_exec: 非法转移兜底 / transition 不推进" {
  // 非法转移兜底 + transition: 错误响应不推进
  let m = model_empty()
  let (m_bad, resp_bad) = model_execute(m, Roundtrip)
  assert_eq(resp_bad, Error(0))
  assert_eq(m_bad, m)
  let t_err = transition(m, Roundtrip, Error(0))
  assert_eq(t_err, m)
  // transition: 正常推进
  let t_ok = transition(m, Seed, Continue)
  assert_true(t_ok != m)
  // Seed 置空台账像; 追加扩序列（含重）; Roundtrip 不动序列
  let (seeded, resp_seed) = model_execute(m, Seed)
  assert_eq(resp_seed, Continue)
  assert_true(seeded.nodes.is_empty())
  let (grown, resp_grow) = model_execute(
    seeded,
    AppendNode(Concrete({ id: 2, })),
  )
  assert_eq(resp_grow, Continue)
  assert_eq(grown.nodes, [2])
  let (dup, resp_dup) = model_execute(grown, AppendNode(Concrete({ id: 2, })))
  assert_eq(resp_dup, Continue)
  assert_eq(dup.nodes, [2, 2])
  let (same, resp_rt) = model_execute(dup, Roundtrip)
  assert_eq(resp_rt, Continue)
  assert_eq(same, dup)
}
