// ===== P2 引用取值与权重 =====

///|
/// 引用取值范围（源 [business].ref_id_range）：越小越利于 shrink 收敛
const REF_ID_RANGE : Int32 = 6

///|
/// 命令权重（源 [business].weights；未声明默认 1，0 表示禁用）。
/// 权重只影响选择概率，合法性仍由 valid 过滤（转移表是唯一权威）。
fn command_weight(name : String) -> Int32 {
  match name {
    "Seed" => 3
    "Roundtrip" => 3
    "AppendNode" => 5
    _ => 1
  }
}

///|
/// node 池（6 条, 索引 = 载荷 id 口径）——Node 五变体全入池:
/// 0 元素带属带文 / 1 纯文本 / 2 注释 / 3 CDATA（含标记与 & 试金石）/
/// 4 PI / 5 空元素双属。片段互不粘体（拼接处无空白节点干扰守恒判定）。
fn node_pool() -> Array[String] {
  [
    "<item id=\"i1\">alpha</item>", "plain text node", "<!--note one-->", "<![CDATA[raw <tags> & bits]]>",
    "<?xls format=\"a\"?>", "<link href=\"u\" rel=\"r\" />",
  ]
}

///|
/// 台账 XML 文档拼装（Seed 骨架 + 追加片段紧排; 系统侧共用此定义）
fn ledger_document(nodes : Array[Int32]) -> String {
  let pool = node_pool()
  let parts : Array[String] = []
  for index in nodes {
    parts.push(pool[index])
  }
  "<?xml version=\"1.0\" encoding=\"UTF-8\"?><ledger seed=\"s0\"><intro>base text</intro>\{parts.join("")}</ledger>"
}

///|
/// 新引用：取值模 REF_ID_RANGE（有限取值空间利于失败复现）
fn fresh_ref(rng : @splitmix.RandomState) -> @qcs.Ref[RefId] {
  Concrete({ id: rng.next_positive_int() % REF_ID_RANGE, })
}

///|
/// P2 generator: 候选全构造 → valid 过滤 → 权重抽取（无合法候选返回 None）
///
/// **size 口径**：本骨架的 size 不参与分布——合法性由转移表决定、序列收缩由 P4
/// 负责；生成器若将来要"按 size 收束"，接在这里。
fn generate_command(
  model : Model,
  size : Int32,
  rng : @splitmix.RandomState,
) -> Command? {
  ignore(size)
  let candidates : Array[Command] = [
    Seed,
    AppendNode(fresh_ref(rng)),
    Roundtrip,
  ]
  let names : Array[String] = ["Seed", "AppendNode", "Roundtrip"]
  let weighted : Array[(Command, Int32)] = []
  for index = 0; index < candidates.length(); index = index + 1 {
    let command = candidates[index]
    if valid(model, command) {
      let weight = command_weight(names[index])
      if weight > 0 {
        weighted.push((command, weight))
      }
    }
  }
  let mut total = 0
  for entry in weighted {
    total = total + entry.1
  }
  if total == 0 {
    return None // 无合法候选：交给 qcs 判 Deadlock
  }
  let mut pick = rng.next_positive_int() % total
  for entry in weighted {
    if pick < entry.1 {
      return Some(entry.0)
    }
    pick = pick - entry.1
  }
  None
}
