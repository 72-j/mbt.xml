// ===== P2 符号响应 mock =====

///|
/// P2 mock: 复用纯模型预测符号响应（本骨架不产生新符号变量）
fn mock_command(
  model : Model,
  command : Command,
  gen_sym : @qcs.GenSym,
) -> (Response, @qcs.GenSym) {
  let (_, response) = model_execute(model, command)
  (response, gen_sym)
}

// ===== P3 响应变量 / 符号解析 / 绑定 =====

///|
/// P3 response_vars: 响应不携带新资源（无新建引用），无变量可提取
fn response_vars(_response : Response) -> Array[@qcs.Var] {
  [] // TODO(P3 人工): 响应携带新资源时在此提取
}

///|
/// 单个引用解析: Concrete 透传，Symbolic 查环境（缺变量报错）
fn reify_ref(
  reference : @qcs.Ref[RefId],
  env : @qcs.Environment[RefId],
) -> Result[@qcs.Ref[RefId], @qcs.EnvError] {
  match reference {
    Concrete(_) => Ok(reference)
    Symbolic(variable) =>
      match env.lookup(variable) {
        Ok(id) => Ok(Concrete(id))
        Err(error) => Err(error)
      }
  }
}

///|
/// P3 reify_command: 逐载荷解析 Symbolic → Concrete
fn reify_command(
  command : Command,
  env : @qcs.Environment[RefId],
) -> Result[Command, @qcs.EnvError] {
  match command {
    Seed => Ok(Seed)
    AppendNode(reference) =>
      match reify_ref(reference, env) {
        Ok(resolved) => Ok(AppendNode(resolved))
        Err(error) => Err(error)
      }
    Roundtrip => Ok(Roundtrip)
  }
}

///|
/// P3 bind_response: 环境透传（响应无新变量）
fn bind_response(
  _symbolic : Response,
  _concrete : Response,
  env : @qcs.Environment[RefId],
) -> Result[@qcs.Environment[RefId], @qcs.BindError] {
  Ok(env) // TODO(P3 人工): 响应产生新变量时在此绑定
}

// ===== P4 收缩 / 重映射 =====

///|
/// P4 remap_command: 命令无符号变量引用，恒可保留
fn remap_command(
  command : Command,
  _scope : Map[@qcs.Var, @qcs.Var],
) -> Command? {
  Some(command) // TODO(P4 人工): 命令引用响应变量时按 scope 重映射
}

///|
/// 引用收缩候选：id 减半、归零（取值空间有限，越小越易读）
fn shrink_ref(reference : @qcs.Ref[RefId]) -> Array[@qcs.Ref[RefId]] {
  match reference {
    Concrete(id) if id.id > 0 =>
      [Concrete({ id: id.id / 2, }), Concrete({ id: 0, })]
    _ => []
  }
}

///|
/// P4 shrink_command: 只收缩引用载荷；结构命令本身已是最简
fn shrink_command(_model : Model, command : Command) -> Array[Command] {
  match command {
    AppendNode(reference) =>
      shrink_ref(reference).map(fn(smaller) { AppendNode(smaller) })
    _ => []
  }
}

// ===== P5 后置条件与不变量 =====

///|
/// P5 postcondition: 严格双执行比较（含错误码）——宁可误报，不可漏报
fn postcondition(
  model : Model,
  command : Command,
  response : Response,
) -> @qcs.Logic {
  let (_, expected) = model_execute(model, command)
  @qcs.Logic::predicate(name="model matches system", value=expected == response)
}

///|
/// P5 invariant: 台账序列口径——索引界内（序列含重合法, 无集合挡板;
/// 守恒律本身在系统侧 conserve_verify 双验, 模型不变量管镜像的自洽）
fn model_invariant(model : Model) -> @qcs.Logic {
  let mut sound = true
  for index in model.nodes {
    if index < 0 || index >= NODE_POOL_LEN {
      sound = false
    }
  }
  @qcs.Logic::predicate(name="ledger sequence discipline", value=sound)
}

///|
test "moonxml_conservation_machine business: 权重与收缩候选冒烟" {
  assert_true(REF_ID_RANGE > 0)
  assert_true(command_weight("Seed") > 0)
  assert_eq(shrink_command(model_empty(), AppendNode(Concrete({ id: 4, }))), [
    AppendNode(Concrete({ id: 2, })),
    AppendNode(Concrete({ id: 0, })),
  ])
}

///|
test "moonxml_conservation_machine business: 池数据面与不变量冒烟" {
  // 池长 = REF_ID_RANGE = NODE_POOL_LEN（索引一对一的口径前提）
  assert_eq(node_pool().length(), NODE_POOL_LEN)
  assert_eq(node_pool().length(), REF_ID_RANGE)
  // 台账拼装: Seed 骨架（空台账）含根与序言; 追加片段进 root 体内
  let bare = ledger_document([])
  assert_true(
    bare.contains("<ledger seed=\"s0\"><intro>base text</intro></ledger>"),
  )
  let one = ledger_document([2])
  assert_eq(
    one, "<?xml version=\"1.0\" encoding=\"UTF-8\"?><ledger seed=\"s0\"><intro>base text</intro><!--note one--></ledger>",
  )
  // 不变量: 空序列 / 界内 / 越界三态
  assert_true(model_invariant(model_empty()) is @qcs.Logic::Predicate(..))
  let seeded : Model = { state: Ledgered, nodes: [0, 2], }
  let logic = model_invariant(seeded)
  assert_true(logic is @qcs.Logic::Predicate(..))
}
