// System - 真实执行适配层 — Generated by QuickMachine Code Generator
// FSM: moonxml_doc_ledger | Config: moonxml_conservation_machine
// Generated at: 1794000000000
// 手维护实例（.hand-maintained 在案）:P0 全重写接 moonxml 公面——生成骨架的
// A 式引擎假定（XqEvent/XqContext/XqEffect/Span）在 moonxml 无对应型, 全部拆除;
// 系统直调 @xml 桥（parse / Document::to_xml）, 守恒律双口径在 conserve_verify
// 落地: ①树守恒（parse∘to_xml 结构等不动点）②串稳定（二次渲染逐字节等）。
// ========================================

// ===== 台账账本（系统侧真值） =====

///|
/// System: 被测系统 = moonxml 解析桥 + 台账（node 池索引序列, 与模型 nodes
/// 同构镜像; 序列语义含重）
priv struct System {
  mut ledger : Array[Int32]
}

///|
fn system_init() -> System {
  { ledger: [], }
}

///|
/// parse 桥归一（XmlError → Error(2); raise 面 try/catch 收 Result）
fn parse_or(source : String) -> Result[@xml.Document, Response] {
  Ok(@xml.parse(source)) catch {
    _ => Err(Error(2))
  }
}

///|
/// 守恒律双口径（本机的被测性质）:
/// ① 树守恒——parse(to_xml(d)) 的 Document 结构等 == d
///   （Document/Element/Node 全 derive(Eq), 结构等即树同构; Node 五变体
///   含 CDATA/注释/PI 的身份都不得丢——CDATA 是试金石: 序列化若把
///   CDATA 降级为转义文本, 树面即破）
/// ② 串稳定——to_xml(parse(to_xml(d))) == to_xml(d)
///   （序列化是 parse∘serialize 的不动点, 二次渲染逐字节等）
/// 违律 → Error(1); 桥故障 → Error(2)
fn conserve_verify(system : System) -> Response {
  let first = match parse_or(ledger_document(system.ledger)) {
    Ok(document) => document
    Err(response) => return response
  }
  let second = match parse_or(first.to_xml()) {
    Ok(document) => document
    Err(response) => return response
  }
  if first != second {
    return Error(1)
  }
  if second.to_xml() != first.to_xml() {
    return Error(1)
  }
  Continue
}

///|
/// 真实执行: Command → 台账操作 → 过桥双验 → Response（守恒律即后置条件）
fn run_command(command : Command, system : System) -> Response {
  match command {
    Seed => {
      system.ledger = []
      conserve_verify(system)
    }
    AppendNode(reference) =>
      match node_index(reference) {
        Some(index) => {
          system.ledger.push(index)
          conserve_verify(system)
        }
        None => Error(3)
      }
    Roundtrip => conserve_verify(system)
  }
}

// ===== 守恒律测试（固定基线; 随机交错由 runner 的 qcs 门承担） =====

///|
test "moonxml 守恒律: Seed 基线过桥——双口径绿 + 台账像同步" {
  let system = system_init()
  assert_eq(run_command(Seed, system), Continue)
  assert_true(system.ledger.is_empty())
}

///|
test "moonxml 守恒律: 全池逐条追加（Node 五变体 + CDATA 试金石）双口径全绿" {
  let system = system_init()
  assert_eq(run_command(Seed, system), Continue)
  for index = 0; index < NODE_POOL_LEN; index = index + 1 {
    assert_eq(
      run_command(AppendNode(Concrete({ id: index, })), system),
      Continue,
    )
  }
  assert_eq(system.ledger, [0, 1, 2, 3, 4, 5])
  // 纯读回: Roundtrip 只验不改
  assert_eq(run_command(Roundtrip, system), Continue)
  assert_eq(system.ledger, [0, 1, 2, 3, 4, 5])
}

///|
test "moonxml 守恒律: 序列语义重复追加合法（与 jsonld 集合挡板分野）" {
  let system = system_init()
  assert_eq(run_command(Seed, system), Continue)
  assert_eq(run_command(AppendNode(Concrete({ id: 1, })), system), Continue)
  assert_eq(run_command(AppendNode(Concrete({ id: 1, })), system), Continue)
  assert_eq(system.ledger, [1, 1])
}

///|
test "moonxml_conservation_machine system: 模型像与系统账逐步同步" {
  // 双执行口径的首尾对账: 命令序列跑完, 模型节点序列 == 系统 ledger
  let mut model = model_empty()
  let system = system_init()
  let script = [
    Seed,
    AppendNode(Concrete({ id: 0, })),
    AppendNode(Concrete({ id: 3, })),
    Roundtrip,
  ]
  for command in script {
    let (_, expected) = model_execute(model, command)
    assert_eq(run_command(command, system), expected)
    model = transition(model, command, expected)
  }
  assert_eq(model.nodes, system.ledger)
}
