// ========================================
// Valid - 转移表约束 — Generated by QuickMachine Code Generator
// FSM: moonxml_doc_ledger | Config: moonxml_conservation_machine
// Generated at: 1794000000000
// 默认实现"可运行但保守"；人工补充点以 TODO(P0)-TODO(P5) 标记
// 手维护实例（.hand-maintained 在案）:v1 保持生成面转移表白名单——XML
// 子节点是有序可重序列, 重复追加合法（与 jsonld 集合挡板分野）。
// ========================================
// valid 是客户端契约：只有转移表声明的 (状态, 命令) 组合合法，
// 生成器据此避免非法命令序列（Deadlock 防护）

///|
/// 检查命令在当前模型状态下是否合法（源: [[transitions]]）
fn valid(model : Model, cmd : Command) -> Bool {
  match (model.state, cmd) {
    // Fresh
    (Fresh, Seed) => true
    // Ledgered: 序列语义, 追加恒合法（载荷无关）
    (Ledgered, AppendNode(_)) => true
    (Ledgered, Roundtrip) => true
    // 兜底: 未定义转移非法
    (_, _) => false
  }
}

///|
/// 前置条件（客户端契约, quickcheck_statemachine 接口形态）
fn precondition(model : Model, command : Command) -> @qcs.Logic {
  @qcs.Logic::predicate(name="valid transition", value=valid(model, command))
}

///|
test "moonxml_conservation_machine valid: 转移表白名单冒烟" {
  // Fresh: 只有 Seed 合法
  let model = model_empty()
  assert_true(valid(model, Seed))
  assert_false(valid(model, AppendNode(Concrete({ id: 1, }))))
  assert_false(valid(model, Roundtrip))
  // Ledgered: 序列语义——同索引重复追加也合法
  let seeded : Model = { state: Ledgered, nodes: [2], }
  assert_true(valid(seeded, AppendNode(Concrete({ id: 2, }))))
  assert_true(valid(seeded, Roundtrip))
  let logic = precondition(seeded, Roundtrip)
  assert_true(logic is @qcs.Logic::Predicate(..))
}
