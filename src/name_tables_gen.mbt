///|
/// 区间表二分查找(各 production 谓词共用;表序由 validate 钉)。
fn xmlname_range_contains(
  table : Array[(Int32, Int32)],
  code_point : Int32,
) -> Bool {
  let mut low = 0
  let mut high = table.length() - 1
  while low <= high {
    let mid = (low + high) / 2
    let (lo, hi) = table[mid]
    if code_point < lo {
      high = mid - 1
    } else if code_point > hi {
      low = mid + 1
    } else {
      return true
    }
  }
  false
}

